    <worksheet name='Age vs Education'>
      <table>
        <view>
          <datasources>
            <datasource caption='Dataset' name='federated.0jj32j30cj3pbe1994f1u147nq3c' />
          </datasources>
          <datasource-dependencies datasource='federated.0jj32j30cj3pbe1994f1u147nq3c'>
            <column datatype='date' name='[Birthdate]' role='dimension' type='ordinal' />
            <column caption='% Total Hired' datatype='real' default-format='p0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1313145234075648] / TOTAL([Calculation_1313145234075648])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Hired' datatype='integer' name='[Calculation_1313145234075648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Employee_ID])' />
            </column>
            <column caption='Location' datatype='string' name='[Calculation_1313145250975754]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [State]&#13;&#10;    WHEN &apos;New York&apos; THEN &apos;HQ&apos;&#13;&#10;    ELSE &apos;Branch&apos;&#13;&#10;END' />
            </column>
            <column caption='Age ' datatype='integer' name='[Calculation_1313145268764685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[Birthdate],TODAY())' />
            </column>
            <column caption='Age Groups' datatype='string' name='[Calculation_1313145270046734]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1313145268764685] &lt; 25 THEN &apos;&lt;25&apos;&#13;&#10;ELSEIF [Calculation_1313145268764685] &gt;=25 AND [Calculation_1313145268764685] &lt;35 THEN &apos;25-34&apos;&#13;&#10;ELSEIF [Calculation_1313145268764685] &gt;=35 AND [Calculation_1313145268764685] &lt;45 THEN &apos;35-44&apos;&#13;&#10;ELSEIF [Calculation_1313145268764685] &gt;=45 AND [Calculation_1313145268764685] &lt;55 THEN &apos;45-54&apos;&#13;&#10;ELSEIF [Calculation_1313145268764685] &gt;=55 THEN &apos;55+&apos;&#13;&#10;END' />
            </column>
            <column caption='Status' datatype='string' name='[Calculation_1313145641361423]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Termdate]) THEN &apos;Hired&apos;&#13;&#10;ELSE &apos;Terminated&apos; &#13;&#10;END' />
            </column>
            <column caption='Highlight Max' datatype='boolean' name='[Calculation_1313145646637072]' role='measure' type='nominal'>
              <calculation class='tableau' formula='WINDOW_MAX([Calculation_1313145234075648]) = [Calculation_1313145234075648]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Education Level]' role='dimension' type='nominal' />
            <column caption='Employee ID' datatype='string' name='[Employee_ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column datatype='date' name='[Hiredate]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Job Title]' role='dimension' type='nominal' />
