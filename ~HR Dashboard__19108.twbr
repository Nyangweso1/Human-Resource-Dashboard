        <column caption='Full Name' datatype='string' name='[Calculation_1313146363240475]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[First Name] + &apos;&apos; + [Last Name]' />
        </column>
        <column caption='Length of Hire' datatype='integer' name='[Calculation_1313146375680028]' role='measure' type='quantitative'>
